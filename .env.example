# Serial Port Configuration
# Copy this file to .env and set your serial port device

# Windows example: COM3, COM4, etc.
# Linux example: /dev/ttyUSB0, /dev/ttyACM0, etc.
# macOS example: /dev/tty.usbserial, /dev/tty.usbmodem, etc.

# For testing
TEST_SERIAL_PORT=COM3

# For integration tests with serdevmock (see docs/INTEGRATION_TESTING.md)
# Leave unset to skip them. Windows example with com0com: COM10
# SERDEVMOCK_PORT=COM10

# For production/examples
SERIAL_PORT=COM3
